{
  "name": "strikebowl",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs && node scripts/build-offline.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "build:test": "tsc --noEmit && vite build --mode test",
    "acceptance": "node scripts/acceptance.mjs",
    "offline:test": "node scripts/offline-check.mjs",
    "campaign:test": "node scripts/campaign-check.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
